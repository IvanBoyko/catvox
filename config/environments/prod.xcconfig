// URL fields store hostnames only: no scheme, path, or trailing slash.
// project.yml composes https:// values for the app Info.plist; the Makefile
// composes https:// values for CLI and integration-test runs.
// Do not write https://... here: xcconfig treats // as a comment and silently
// truncates the value to https:.
// Boolean fields use lowercase true or false only.

CATVOX_PROJECT_ID = kathelix-catvox-prod
CATVOX_ENVIRONMENT = prod
// Environment security tier (ADR-0026). true = protected: the generic validator
// requires App Check ENFORCED, WIF ref pinned, ABANDON deletion policy, and that
// this environment is absent from the integration-safe list.
CATVOX_ENVIRONMENT_PROTECTED = true
CATVOX_FUNCTION_REGION = us-central1
CATVOX_FIRESTORE_LOCATION = nam5
CATVOX_TF_STATE_BUCKET = catvox-tf-state-kathelix-catvox-prod
CATVOX_GCP_CI_SERVICE_ACCOUNT = catvox-ci-sa@kathelix-catvox-prod.iam.gserviceaccount.com
CATVOX_GCP_WIF_PROVIDER = projects/953500951129/locations/global/workloadIdentityPools/github-actions-pool/providers/github-actions-provider
// WIF ref pin: in a protected GitHub Environment, CI auth requires both the
// matching environment and this ref. See ADR-0024.
CATVOX_GCP_WIF_GITHUB_REF = refs/heads/main
CATVOX_IOS_BUNDLE_ID = com.kathelix.catvox
CATVOX_FIREBASE_IOS_APP_DISPLAY_NAME = CatVox Prod iOS
CATVOX_FIREBASE_IOS_APP_DELETION_POLICY = ABANDON
CATVOX_FIREBASE_APPLE_TEAM_ID = QYT76L5836
// Firestore App Check enforcement. Protected environments use ENFORCED
// (secure-by-default): Firebase client SDK access needs a valid App Attest
// token; service-account / Admin SDK access (backend SA, CI probes) bypasses
// App Check. See ADR-0025.
CATVOX_FIREBASE_FIRESTORE_APP_CHECK_ENFORCEMENT = ENFORCED


CATVOX_MANAGE_GCF_SOURCES_BUCKET_IAM = true
CATVOX_SIGNED_UPLOAD_URL_HOST = getsigneduploadurl-pdkw5uifga-uc.a.run.app
CATVOX_ANALYSE_VIDEO_HOST = analysevideo-pdkw5uifga-uc.a.run.app
CATVOX_FIREBASE_APP_ID = 1:953500951129:ios:1595a4c27cd8f3f7964748
CATVOX_FIREBASE_API_KEY = AIzaSyAMKDQ_mIGQWQF4VhU8lytvvGx1TpuoBMI
CATVOX_POSTHOG_PROJECT_TOKEN = phc_whSuErj3g6ZZNt7c99so5Aykkuyr2LRsYdzpa92LgG2X
CATVOX_POSTHOG_HOST_NAME = us.i.posthog.com
CATVOX_POSTHOG_API_HOST_NAME = us.posthog.com
