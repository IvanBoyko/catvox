{
  // Existing project docs favor prose-oriented long lines, compact lists/tables,
  // raw reference URLs, and the Gemini system prompt's nonstandard Markdown
  // shape. Keep those conventions out of CI noise while retaining the rest of
  // markdownlint's structural checks.
  "default": true,
  "MD007": false,
  "MD012": false,
  "MD013": false,
  "MD022": false,
  "MD025": false,
  "MD026": false,
  "MD030": false,
  "MD031": false,
  "MD032": false,
  "MD034": false,
  // MD060 is active in markdownlint v0.40; existing docs use compact table pipes.
  "MD060": false
}
