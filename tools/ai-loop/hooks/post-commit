#!/usr/bin/env bash
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
git_dir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
commit_message="$(git log -1 --format=%B 2>/dev/null)" || exit 0

case "$commit_message" in
  *"[ai-loop]"*) ;;
  *) exit 0 ;;
esac

case "$git_dir" in
  /*) ;;
  *) git_dir="${repo_root}/${git_dir}" ;;
esac

lock_dir="${git_dir}/ai-loop.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  printf 'ai-loop: lock exists, skipping continuation\n' >&2
  exit 0
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

if ! python3 "${repo_root}/tools/ai-loop/ai_loop.py" continue --trigger post-commit; then
  printf 'ai-loop: continuation failed; commit was left intact\n' >&2
fi
